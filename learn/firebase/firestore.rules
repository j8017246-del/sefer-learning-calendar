rules_version = '2';
// Each person may read and write only their own data:
//   users/{uid}               - email, optional display name, sharing switch (off unless turned on),
//                               daily reminder time and time zone
//   users/{uid}/plans/{plan}  - one learning plan: as text ("data") and in plain fields ("plan")
//   users/{uid}/days/{day}    - one record per day done, missed or moved, or learning entered by hand
//                               for before the app; never changed once written
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function okId(id) {
      return id.matches("^[A-Za-z0-9_-]{1,64}$");
    }
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["email", "updatedAt", "displayName", "shareLearning", "reminderTime", "timeZone"])
        && (!("displayName" in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60))
        && (!("shareLearning" in request.resource.data) || request.resource.data.shareLearning is bool)
        && (!("reminderTime" in request.resource.data) || (request.resource.data.reminderTime is string && request.resource.data.reminderTime.matches("^[0-2][0-9]:[0-5][0-9]$")))
        && (!("timeZone" in request.resource.data) || (request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 64));
      match /plans/{planId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && okId(planId)
          && request.resource.data.keys().hasOnly(["data", "plan", "updatedAt"])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
          && (!("plan" in request.resource.data) || request.resource.data.plan is map);
      }
      match /days/{dayId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && okId(dayId)
          && request.resource.data.keys().hasOnly(["planId", "seferIds", "type", "date", "doneOn", "at", "from", "until", "choice", "toDate", "stoppedAt", "finishDate",
                                                    "byHand", "node", "year", "note", "minutes"])
          && request.resource.data.type is string;
        // a day's record is kept as it was written
        allow update: if false;
      }
    }
    // A plan shared with a chavrusa (only when its owner shares it): anyone signed in
    // with the link (an id no one can guess) can open it; nobody can list them.
    // Each member adds only themselves and writes only their own progress.
    match /shares/{shareId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && okId(shareId)
        && request.resource.data.keys().hasOnly(["owner", "ownerName", "plan", "createdAt", "members", "progress"])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.plan is string && request.resource.data.plan.size() < 900000
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 60
        && request.resource.data.progress is map && request.resource.data.progress.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members", "progress"])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() <= resource.data.members.size() + 1
        && request.resource.data.members.size() <= 20
        && request.auth.uid in request.resource.data.members
        && request.resource.data.progress.diff(resource.data.progress).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    // everything else is closed
  }
}
