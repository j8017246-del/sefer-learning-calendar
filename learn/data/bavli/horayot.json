פינן מעיני מעיני","אבל חד שבט דליכא רובא לא","רבי שמעון תמניא בעי","אי בהוראת בית דינו רבי שמעון","אלא לאו רבי יהודה היא","אמרי הכא במאי עסקינן וכו'","איבעיא להו שבט אחד שעשה בהוראת","אלא הכא במאי עסקינן כגון שחטאו","אלא לאו רבי שמעון","מדכתיב קהל יהודה אלמא דשבט אחד","ודלמא שאני שבט יהודה דהוה עמיה","אלא מהכא הנני מפרך והרביתיך ונתתיך","מאן הוה אתיליד ליה בההיא שעתא","י\"א שבטים לא","הכל עולה סלקא דעתך","אף חטאת","ואידך דב\"ד","בין לר' יהודה בין לר' שמעון","לפי שאין מיתה בצבור","אילימא מדכתיב תחת אבותיך יהיו בניך","אי הכי אפי' ביחיד נמי","משעיר דר\"ח","והנך ישראל דפיישו","היכי מייתו","מי דמי שעיר דר\"ח","ראויה כפרה זו","התם גבי עגלה ערופה כולהו איתנהו","ודלמא מעוטי הוו","הא לא מצית אמרת דמעוטי הוו","והא מזידין הוו","הוראת שעה היתה","תנו רבנן מת אחד מן הצבור","מת אחד מן ב\"ד","דאין צבור מתים","שמעינן ליה לר\"ש דאמר חטאת השותפין","רבי יהודה אומר כולן ימותו","אמר ליה רב יוסף כהנים קא","אלא מעתה","וכ\"ת הכי נמי טפי להו שבטים","אלא אמר רב אחא בר יעקב","ונתתיך לקהל עמים ונתתי את הארץ","כראובן ושמעון יהיו לי","והא כתיב על שם אחיהם יקראו","כנחלתם כך חנייתם","מאי הוי עלה","ת\"ש דתניא ר\"ש אומר וכו' שאין","שאין תמורה בצבור","שנתכפרו בעליה ושעברה שנתה לא שמענו","וכי דנין אפשר משאי אפשר","הא לא קשיא דלא הוי דנין","פרק שני","מתני' הורה כהן משיח","גמ' שוגג ועשה שוגג מביא פר","מהו דתימא כיון דאי מתידע ליה","שיכול לגמור מדין קל וחומר שמשיח","צבור מוצא מכלל יחיד","נשיא מוצא מכלל יחיד","מה נשיא בשגגת מעשה בלא העלם","צבור בפר ואין מביאין אשם תלוי","נשיא משיח מביאין שעירה בעבודת כוכבים","ומביא אשם ודאי","ומנא ליה","דכתיב באשם תלוי וכפר הכהן על","לאשמת העם ע\"כ לא קאמר ליה","אלא אשם כדי נסבה","מתני' הורה","נתכפר לו בפני עצמו","הורה עם הצבור","נתכפר לו עם הצבור","ולא בעבודת כוכבים","גמ' מה נשיא חטא עם הצבור","ת\"ל דכתיב בכהן משיח על חטאתו","ה\"ד דכי הורה משיח בפני עצמו","אי דהוא מופלא ב\"ד והן אינן","ובעי איתויי","כשבה או שעירה","ואי הן מופלאין והוא אינו מופלא","והא הוראה דידיה לאו כלום היא","אמר רב פפא","בשני מקומות","בטעמייהו בפסוקים דחלב ועבודת כוכבים מתרי","וחלוקין בקרבנות","דהוא שעירה","הוא בחלב המכסה את הקרב","אע\"ג דקרבנן שוה","כיון דמתרי קראי קא אתו","הא פליגין בטעמייהו","או דלמא שם חלב אחד הוא","והן בדם","בתר קרבן אזלינן","לפי שיצאה עבודת כוכבים","נאמר כאן","ונאמר להלן מעיני","מה להלן ב\"ד","מתני' אין חייבין בקרבן וכו'","גמ' ואילו משיח בעבודת כוכבים לא","מתני' מני ר' היא דתניא משיח","וחכ\"א בהעלם דבר","ותסברא זדונו כרת ושגגתו חטאת","אלא תנא בהא","הכא נמי תנא בהא","מאי טעמא דרבי אמר קרא","ורבנן סברי מי שחטאו בשגגה","יצא משיח שאין חטאתו בשגגה","ושוין שאין","ורבנן סברי יצא משיח שאין חטאו","מתני' אין ב\"ד חייבין","וכן המשיח","גמ' נאמר כאן עליה","ונאמר להלן","נשיא נמי לא יביא שעיר אלא","יחיד נמי אינו מביא חטאת אלא","אמר קרא","וילמוד תחתון מעליון","לפי שיצאה עבודת כוכבים","יכול יהו חייבין על דבר שאין","וילמוד תחתון מעליון","אלא לרבנן","תורה אחת יהיה לכם לעושה בשגגה","מה עבודת כוכבים שחייבין על זדונו","אשכחן יחיד ונשיא ומשיח בין בעבודת","צבור מנלן ילמוד עליון מן התחתון","רבים בסייף","יכול נחלוק בשוגג בקרבנותיהם","ת\"ל תורה אחת","מאי נייתי","נייתי פר צבור בשאר מצות הוא","יחיד נמי היינו קרבנו","איצטריך תורה אחת דס\"ד וכו'","אי נמי צריך","ואין לו תקנה","קמ\"ל תורה אחת דמייתי כל חד","ולא תעשו את כל המצות איזו","כתיב כל אשר צוה ה' אליכם","איזו היא מצוה שהיא בדבורו של","למן היום וגו'","י' מצות נצטוו במרה","מחוורתא כדשנינן מעיקרא","מתני' אין ב\"ד חייבין קרבן על","ואין מביאין","אשם תלוי על עשה ועל לא","אבל חייבין","פרוש מן הנדה","אל תבא על הנדה","גמ' מנא הני מילי","ויחיד אשם תלוי נמי","אמר רב יצחק בר אבדימי נאמר","ונאמר ואשמו בצבור מה ואשם","אף ואשם האמור באשם תלוי אינו","אי הכי קרבן עולה ויורד נמי","זו היא שיבה זו היא ביאה","נילף ואשם מטומאת מקדש וקדשיו","דנין ואשם ומצות ה'","נילף ואשם ונשיאת עון","באשם תלוי כתיב ואשם ומצות ה'","מתני' אין ב\"ד חייבין על שמיעת","והנשיא כיוצא בהן","ר\"ע אומר הנשיא חייב בכולן","גמ' והיה כי יאשם לאחת מאלה","ואימא כי יאשם לאחת הכי משמע","אלא טעמא דר' יוסי הגלילי מהכא","לא תגיע ידו לא תשיג ידו","נשיא שאין על גביו שום אדון","נשיא שנצטרע","מהו מי אמרי' פטור מקרבן עולה","א\"ל ממאי קבעית לחיוביה לאתויי קרבן","תניא ר\"ע אומר משיח פטור מכולם","אימא כי מעטי' קרא","מדלי דלות","מדלות לא מעטיה","לא ס\"ד דכתיב","ושאין מתכפר באחת מהן","אין מתכפר בכולם","אלא מעתה האי דכתיב לאחת מאלה","נכתביה רחמנא להאי מאחת בדלות","אי נמי בעשירות","מתני' כל המצות שבתורה שחייבין על","ובעבודת כוכבים יחיד ונשיא ומשיח מביאים","וב\"ד מביאין פר ושעיר","אשם תלוי היחיד והנשיא חייבים בית","אשם ודאי יחיד ונשיא ומשיח חייבין","וב\"ד פטורים","על שמיעת קול ובטוי שפתים וטומאת","יחיד ונשיא ומשיח חייבין","אלא שאין כ\"ג משיח חייב על","ומה הן מביאין","ר\"א אומר נשיא מביא שעיר","גמ' היה נותן בהן כלל","כל שהוא בעולה ויורד","משיח וב\"ד פטורין","קשיין אהדדי","בדלי דלות","דר\"ש סבר לה כר\"ע בחדא","ופליג עליה בחדא","מ\"ט דר' שמעון","דכתיב בטומאת מקדש וקדשיו ונכרתה הנפש","מי שקרבנו שוה לקהל","יצא משיח שאין קרבנו שוה דאין","א\"כ נשיא נמי אין קרבנו שוה","ומשני הא לאו מילתא היא משום","אי הכי כהנים נמי הא לא","הא לא קשיא משום דכהנים שוו","כהן משיח נמי הא שוה לקהל","אלא אמר רבא אימא הכי","א\"ר יוחנן לא א\"ר אליעזר","אלא בטומאת מקדש וקדשיו הואיל ונאמר","אמר רב פפא הכי נמי מסתברא","מכדי שעיר","ניתני נמי משיח מביא פר בשמיעת","אלא לאו","א\"ל רב הונא בריה דרב נתן","א\"ל ר\"ע מי פטר","ותו לא מידי","א\"ר יוחנן","תני תנא קמיה דרב ששת אשם","א\"ל דאמר לך מני ר\"א היא","קשיא דמתני' דידך לא מיתוקמא דלא","פרק שלישי","השתא יש לומר עבר ממשיחותו ואחר","מה\"מ דמשיח שעבר ואח\"כ חטא דמביא","מתני' חטאו עד שלא נתמנו ואח\"כ","ר\"ש אומר אם נודע להם עד","גמ' אם הכהן המשיח יחטא","פרט לקודמות","ומה נשיא שמביא בשגגת מעשה אין","שאין מביא חטאתו משעבר","יכול גזרה","ת\"ל אם הכהן המשיח יחטא","גזרה מהיכא תיתי","אין דודאי אשכחן כה\"ג","דכתיב ונתתי נגע צרעת בבית ארץ","ר\"ש אומר","פרט לנגעי אונסין","אדם כי יהיה בעור בשרו מדבור","מה זב מדבור ואילך","תאמר בנגעי אדם שמטמאין באונס","רבא אמר","רב פפא אמר","וישב בבית החפשית","מכלל דעד השתא עבד הוה","וסולתא סולת ולהכי נקט בהדי פיתא","ומתעה את הספנים","אמר לו כל כך","נתן רבן גמליאל דעתו עליהם להושיבם","כמדומין אתם ששררה אני נותן לכם","עבדות אני נותן לכם","אשר כמו אשרי","צריך אתה לומר מהו הדיוט","מהו על זדונו","שאני הכא דשני קרא בדבוריה","אשריהם לצדיקים","אוי כמו ווי דהכא לא כתיב","צדיקים אי אכלי תרי עלמי מי","אלא אמר רבא אשריהם לצדיקים שמגיע","ואוי להם לרשעים שמגיע להם","אוקימתון מסכתא פלן","איעתריתו פורתא","אמרו לו אין דזבנן","קרי עלייהו אשריהם לצדיקים שמגיע אליהם","לשם אכילה גסה","מי דמי אנן קאמרינן חד דרך","והכא שני דרכים","נפשע נמרד שמרד בו שפירש ממנו","מקרית עוז","שהטיל מדינים","לתאוה של עבירה יבקש נפרד","זה לוט","יתגלע כמו לפני התגלע לשון גלוי","תמר זנתה","זמרי זינה","מדקאמר גדולה עבירה לשמה ממצוה שלא","אלא אימא גדולה עבירה לשמה","בין רגליה כרע נפל שכב","נתכוונה לשם מצוה","מ\"ב קרבנות","יצאה ממנו רות","דקרייה מואב","בן עמי","אמר אל תצורם ואל תתגר בם","וקדמתה ארבע דורות","ת\"ר ואם נפש אחת תחטא בשגגה","למה לי מעם הארץ","שיכול כלומר אילו לא נאמר מעם","ת\"ל מעם הארץ פרט למשיח","אלא נשיא הא בשגגת מעשה הוא","ס\"ד אמינא","קמ\"ל מעם הארץ פרט לנשיא דאינו","אלא לרבנן דאזלי בתר חטאה","מאי איכא למימר","ס\"ד אמינא נצטרף","קמ\"ל מעם הארץ פרט לנשיא דכהאי","כגון שאכל חצי זית חלב כשהוא","אכל ספק חלב כשהוא הדיוט","ונתמנה ונודע לו על ספקו","מהו מי מייתי אשם תלוי או","מדאישתני לודאי","או דלמא כי אישתני לודאי","אבל הכא","דלא אישתני קרבן דידיה","מעם הארץ","פרט למומר","אלא הכא באוכל נבילה לתאבון","קתני אכל חלב שחוטה זה מומר","להכעיס דאית ליה היתרא ואכיל איסורא","הרי זה צדוקי","אוכל נבילה וטריפה שקצים ורמשים ושתה","ר' יוסי בר רבי יהודה אומר","מאי איכא","ת\"ק סבר כלאים דאורייתא דומיא דחלב","ור' יוסי סבר אף הלובש נמי","חד אמר","להכעיס דאית ליה היתרא ואפי' הכי","אכל פרעוש או יתוש הרי זה","לעולם אימא לך להכעיס צדוקי הוא","מה להלן שאין על גביו אלא","כגון אני מהו בשעיר","א\"ל הרי צרתך בבבל","התם שבט","והכא מחוקק","מתני' איזה הוא המשיח","ולא מרובה בבגדים","אין בין כהן משוח בשמן המשחה","ואין בין כהן המשמש","וזה וזה","שוים בעבודת היום","גמ' שמן המשחה שעשה משה","בו שולקין את העקרים","והלא לסוך בו את העקרים אינו","אלא שורה את העקרים במים","ומציף עליהן שמן","וקפחו ומוציא השמן לאלתר וקפחו כמו","טעון משיחה","מפני מחלוקתו","ממלכתו הוא ובניו בקרב ישראל","ולא כל דבעי מלכא מורית לבניה","ירושה היא","משום דמלך ראשון הוא","זה דמלכות בית 