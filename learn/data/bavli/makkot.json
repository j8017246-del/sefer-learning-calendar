 חייב","ה\"ג כאן בירידה שלפניו ועליה שלאחריו","לימא כתנאי","לנזקין חייב אם לא הרגו אלא","הא דאתליע","הא דמהדק","מתני' מן העץ המתבקע","גמ' נאמר עץ למטה","ונאמר עץ למעלה","יש אם למסורת","הא דרב יצחק בר' יוסף בסנהדרין","היינו דקא הדר רבי ואמר ועוד","פיסא רגב גוש עפר כלישני\"א בלע\"ז","ואתר תמרי","מהו דתימא","לגרמא הוא עץ החריות שהתמרים תלוין","ומחיה לכובסא","מתני' ר\"א בן יעקב","האב המכה את בנו","ושליח ב\"ד","גמ' ליפנות בה","ואיכא דמיקרי ויתיב","ומצא משמע שהוא שם ומצאו נשירת","פרט לממציא עצמו","ומצא פרט למצוי","השתא נמי","לאו מצוה","לאו מצוה","לאו מילתא היא דאמרי","דאי בעי מיטמא אי בעי לא","ה\"נ דפטור","לרבות טבול יום","לרבות מחוסר כיפורים","מעוד קאמינא","איכא דמתני לה","אין צ\"ל חריש וקציר של שביעית","הנכנס לשביעית","וקציר של שביעית היוצא למוצאי שביעית","רבי ישמעאל אומר מה חריש רשות","אם מצא חרוש אינו צריך לחרוש","לאו מילתא היא דאמרי","מאי טעמא קציר דומיא דחריש","ואי ס\"ד מצוה","מתני' ע\"י הבן","חוץ מגר תושב","הכל גולין","גמ' בשוליא דנגרי","חיותיה הוא","מכה נפש","פרט למכה אביו","לרבן שמעון דאמר","ולרבנן דאמרי סייף חמור מחנק הורג","רבא אמר","לוקה דלטייה","שהעיד בו","שאין בה שוה פרוטה","ולא מקשינן הכאה לקללה","חוץ מגר תושב","ל\"ק כו' גר תושב שהרג גר","לפיכך אשבע מצות שנצטוו בני נח","מה עובד כוכבים ל\"ש קטל בר","לאו בר מיניה","אף גר תושב לא שנא קטן","דלאו בר מיניה","באומר מותר","ואזדו לטעמייהו","כסבור בהמה","חייב מיתה","מאי לאו בידי אדם","לאלהים ולא לאדם","הגוי גם צדיק תהרוג","כדקא מהדרי ליה עילויה","מתני' מפני שהוא כמועד","ויש שונא שאינו גולה","כל הריגה שיכולין לומר על הריגה","שלא לדעת הרג","גמ' בלא ראות פרט לסומא","פרט למתכוין","להבחין בין שוגג למזיד","נפסק החבל ונפל עליו אין לומר","נשמט החבל מידו ונפלה עליו אינו","לעולם אינו גולה","מחצלו הוא מעגילה שפעמים שטחין במחצלים","הכי גרסי' נשמט אנשמט לא קשיא","נפסק אנפסק לא קשיא הא רבי","מתני' עד שלא נבחרו שלש שבארץ","לא היו שלש","וידברו אליו","בתחלה כלומר תחלת משפט כל הרוצחים","גמ' ומכוונות היו","ושלשת את גבול ארצך וגו' שיהו","בעבר הירדן תלת כו'","בגלעד שהיא בעבר הירדן שכיחי רוצחים","עוקבין אורבין","מהאי גיסא ומהאי גיסא דמרחקי","ומ\"ש מציעאי דמקרבי","בין לדעת בין שלא לדעת","פרוודהא כפרים וחצרים הסמוכות לה ונקראות","וערי מבצר","ערים הללו","טירין קטנים","ולא כרכים גדולים","כגון סליקום","ואם אין שם מים","במקום שווקים","במקום אוכלוסין","כלי זיין","וכלי מצודה","מאי קרא","לתלמיד שאינו הגון","לימנות בהצלה תחלה","הזרח שמש לרוצחים","הזרחת שמש לרוצחים","ללמד בהמון","שכל תבואה שלו","ורבנן ואיתימא רב מרי אמרי מי","יהבו רבנן עינייהו ברבה","רב אשי אמר כו'","ללמד בהמון","נואלו שרי צוען","ללמד בהמון","לו תבואה","בשעריך בשביל שעריך","מאלף עולות כו'","מקלט היה כתוב על פרשת דרכים","פתח ליה פיתחא","והאלהים אנה לידו","במה הכתוב מדבר","נופל עליו והורגו","בדרך תלך","אם ללצים","הוא יליץ","ומצאו גואל הדם","בגואל הדם הכתוב מדבר","ברוצח הכתוב מדבר","הרי רוצח אמור כו'","הרבה שליחות עושה","פשיטא כיון דהוא גולה ודאי בשוגג","בתחלה תחלת משפטן של רוצחים ועיקרו","רבי אומר","ודבר באזני זקני העיר ההיא","מצוה בעלמא","בבן סורר ומורה","בלשון עזה","מפני שהן של תורה","ידבר עמים","מפני ששיהם","פליגי בה","חד אמר שמנה פסוקים","למען תהיה תורת וגו'","כי איתקש למותר בפיך","להלכותיהן לדבר שאינו כתוב בתורה ובתפילין","דבי חביבי","מתני' אחד כהן משוח בשמן המשחה","ואחד המרובה בבגדים","ואחד שעבר ממשיחותו","מחזירין את הרוצח","משוח מלחמה","גמ' וישב בה עד מות הכהן","שהיה להן לבקש רחמים על דורן","הכא אמרי","טוביה חטא וזיגוד מנגיד","התם אמרי'","שכם נסיב מבגאי גזר","שכרה דוד שיתין","קפא תהומא","מי שרי למכתב שם","נשא אחיתופל כו'","ימחה על המים","אפי' על תנאי","וחטאתי לך","מאי דכתיב יחי ראובן וגו' וזאת","על איבריה לשפא","ידיו רב לו","למשקל ולמטרח","ליהדר בהנך","מתני' ה\"ז אינו גולה","חוזר במיתתו של שני","נגמר דינו בלא כ\"ג","גמ' שנמשח בימיו","מאי הוה ליה","תנא מת","ונעשה כ\"ג בן גרושה","מתה כהונה","בטלה כהונה","אליבא דרבי אליעזר כ\"ע לא פליגי","כי פליגי אליבא דרבי יהושע","פועל ידיו תרצה","טעה יואב","מזבח בית עולמים","ה\"ג והוא תפס במזבח של במה","שרו של רומי","חמוץ בגדים","לא נתנו לקבורה","תיפוק ליה","אין עושין","למחילות תחת הקרקע שאין אוכלות במגרש","ורצח איכא לפרושי לשון ציווי כמו","סופו חמור מתחלתו","אב שהרג את הבן","הא דתניא נעשה","לכל אין הבן נעשה וכו'","ה\"ג אלא לא קשיא הא בבנו","מתני' הכל הולך אחר הנוף","גמ' אילן שהוא עומד בפנים","מכנגד החומה וכו'","בחומה תלה רחמנא","בדירה תלה רחמנא","בירושלים לענין מעשר הלך אחר הנוף","רבי יהודה","הלך אחר פתחה","באילן הלך אחר נופו","אימור דשמעת ליה כו'","עיקרו בחוץ ונופו בפנים כו'","עיקרו בפנים ונופו לחוץ","אלא בערי מקלט","אמר רבא בעיקרו כולי עלמא לא","רב אשי אמר מאי אחר הנוף","מתני' הרג באותה העיר","גולה משכונה לשכונה","ובן לוי","גמ' ושמתי לך בחייך","מקום ממקומך","פלך מדינה","מאי קרא","בעיר מקלטו","מתני' אם אמרו לו אעפ\"כ","מעלים היו","חוזר לשררה שהיה בה","גמ' מחלוקת בשש","לכם לרוצחים נאמר והיו לכם הערים","ושב אל משפחתו","למה שהוחזקו אבותיו","אל אחוזת אבותיו כאבותיו","וכן בגולה","לרבות את הרוצח","מתני' אלו הן הלוקין","נתינה מן הגבעונין היא ומלקות משום","אלמנה וגרושה","גרושה וחלוצה","טמא שאכל את הקודש","נותר כתיב ביה ושרפת את הנותר","והשוחט קדשים בחוץ או המעלה קדשים","האוכל ביום הכפורים","המפטם את השמן","והסך בשמן המשחה","אכל טבל","ומעשר ראשון שלא נטלה תרומתו","ומעשר שני שלא נפדה","הקדש שלא נפדה","באוכל נמלה גרסינן שהוא חייב","גמ' חייבי כריתות קתני","ישנו בכלל מלקות ארבעים","רבי עקיבא אומר חייבי כריתות","שאם עשו תשובה כו'","רבי יצחק אומר","למה יצאת כרת באחותו","לדונו בכרת","לאו שאין בו מעשה נמי","דומיא דלאו דחסימה","ורבי עקיבא","מאי אמרת","שאם עשה תשובה","לעיני ונכרתו לעיני בני עמם וכתיב","נגמר מעיני","זו היא שיבה כו'","ועוד נגמר מעיני","קיבלה מיניה רבי שמואל","דאתרו ביה למלקות","לאזהרת מיתת ב\"ד","אין לוקין עליו","פסח ומילה","לקרבן שאם יעשה שוגג יביא קרבן","פסח ומילה","התם לאו היינו טעמא","כדאמרינן מעיקרא","ורבנן רבי ישמעאל ור\"ע","לחלק לפי שכלל כל העריות בכרת","מואל אשה","לחייבו על אחותו ועל אחות אביו","הרי שמות מוחלקין","ברשיעא בר רשיעא","באטליז במקום שמוכרין הבשר במקולין","מאחותו דסיפא","שאין עונשין מן הדין","גמר עונש מאזהרה","מאחותו דרישא","למפטם וסך","ה\"ג לה להך שיטתא ההוא מיבעי","שיצא מדוה דרך ערותה","אלא אזהרה מנלן","מבכל קדש לא תגע","תני ברדלא","כתיב וטומאתו עליו","גזירה שוה לא גמר","ששוה בזרעו של אהרן","ההוא אזהרה לתרומה","טמא שנגע בקדש כו'","מדאיתקש קדש למקדש","ר' יוחנן לטעמיה","ההוא מבכל","תניא כריש לקיש","כל לא תעשה שקדמו עשה לוקין","אמרו לו","אמר להם לא","כתיבא ותנינא","תנינא הבא אל המקדש טמא","משום דקשיא ליה אונס","אם ישראל הוא","ואם כהן הוא","ואמאי אם ישראל הוא מחזיר ואינו","אמר עולא","אם אינו ענין","ואכתי הא איצטריך למיכתביה וישנו ענין","מה אונס שאינו לוקה","שהרי אשתו היא","וגמר מיניה","אי בק\"ו","אלא אמר רבא","והא לא דמי לאויה","מיגרע גרע","ההוא לנתוקי לאויה אתא","הניחא למאן דתני בטלו ולא בטלו","מידי הוא טעמא אלא לרבי יוחנן","האמר ליה רבי יוחנן לתנא","א\"ל מאי קאמרת","ה\"ג תני בטלו ולא בטלו","קיימו ולא קיימו","רבי יוחנן סבר התראת ספק שמה","וריש לקיש סבר התראת ספק לא","דאמרי תרוייהו אינו לוקה","אוכל ולא אכל","משום דה\"ל לאו שאין בו מעשה","משום דהויא לה התראת ספק","ותרוייהו אליבא דרבי יהודה","הא ודאי התראת ספק היא","כי אידך תנא","הא ודאי התראת ספק היא","הכה זה כו'","בבת אחת","חוץ מנשבע וממיר ומקלל את חבירו","קשיא דרבי יהודה אדרבי יהודה","לר\"ש דקשיא ליה התראת ספק תרי","לר' יוחנן","הא דידיה והא דרביה","לוקה ואינו משלח","וחכ\"א כו'","זה הכלל כל מצות לא תעשה","א\"ר יוחנן אנו אין לנו כו'","מחזיר ואינו לוקה","הניחא למאן דתני","אלא למאן דתני ביטלו","הניחא בשילוח הקן משכחת לה","בדרבה מיניה","כל כמיניה","הניחא למאן דאמר כו'","על דעת רבים","ותו ליכא","משכון משכחת לה ביטלו ששרפו","הרי משכונו של גר","התם גברא בר תשלומין הוא","תעזוב אותם","משכחת לה בביטלו","מירחו ונתחייב במעשר מעשר תחלה את","אבל לדבר מצוה","דהוה פשע בינוקי","אדריה רב אחא","ביניתא דבי כרבא","אכל פוטיתא","לוקה ארבעה","נמלה בלע נמלה חיה הואיל ובריה","צרעה לוקה שש","בקרנא דאומנא","ריסק מיעך וכיתת וביטלן מתורת בריה","אפילו שנים","טבל של מעשר עני","מה להלן מעשר עני","אין צריך לקרות את השם","קורא ואין צריך להפריש","רבנן סברי ודאי טביל","לא נחשדו","אפרושי מפריש ליה","מחלוקת בחטה","כך מחלוקת בזו","מתני' עד שלא קרא עליהן","קדשי קדשים חוץ לקלעים","קדשים קלים","המותיר בטהור אינו לוקה","השובר עצם בטמא כדאמרינן בפסחים ועצם","לוקה ואינו משלח","חכמים אומרים משלח ואינו לוקה","גמ' זו דברי ר' עקיבא","הנחה לפני המזבח מעכבת בהן דשנה","ונימא זו דברי ר' שמעון","מאי ר' שמעון","ותרומ