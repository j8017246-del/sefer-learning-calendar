י מזבח","בבכור שורך ולא","בצאן לוקה מן","הסיט כפול לא","ספק קדשים כגון","בהמת הקדש שנפל","עד שתשחט נשחטה","או קדם מום","אלא מדבריהם נפדת","והמעשר שהקדושה חלה","לחולין להגזז ולהעבד לעולם","מותר לתלוש את","שתלש או שנשר","מפני מומן גזירה","והאשם מותר בהנייה","ואם נתלש מן","בהנייה שהרי לא","השוחט בכור או","קדשי בדק הבית","המקדיש עובר למזבח","גזרו בה והרי","הבית בין למזבח","קדשים קלים אין","לבית הדשן שהרי","שלהן למזבח קודם","זריקה אין מועלין בהן עד שיזרק הדם נזרק","מועלין בהן שהזריקה","כל קדשי קדשים","כיצד העולה אחד","ומנחת נסכים מועלין","וכן פרים הנשרפין","וכן פרה אדומה","חטאת בהמה ואשם","מועלין באימוריהן עד","בה משהוקדשו עד","והנהנה בהן אחר","המנחות מועלין בהן","קרב הקומץ הותרו","הואיל והקטרה זו","לחם הפנים מועלין","הבזיכין הותר באכילה","דם הכבשים נזרק","הנסכים מועלין בהן","כל זמן שהן","שהרי הן מכלל","לוג שמן של","ולא מועלין עד","כל דמי שחיטת","יצא לנחל קדרון","קדשים הרי הוא","העצמות והגידים והקרנים","בהן פירשו לאחר","מועלין בהן לאחר זריקה","עצמות העולה שפקעו","בהן אף על","גחלת שפקעה מעל","דשן המזבח החיצון","דישון המזבח הפנימי","כל בהמת קדשי","קבוע ואפילו היתה","זמן ובני יונה","ואינן ראויין לפדיון","קדשי מזבח שמתו","נפסלו בדברים שיפסלו","בשלא היה להן","ואחר כך נפסלו","ראוי לאכילה כמו","כגון ששחטן בדרום","בלילה או ששחט","הפסולין את דמן","או שיצא הדם","שהרי לא היה","או שנטמא הבשר","זריקת דמים בכל","קיבלו הפסולין את","אין מועלין בבשרן","לעבודת צבור עושה","כיצד קיבל הטמא","שעת היתר ומועלין","שאין בקדשים קלים","המועלת אבל קדשים","אם יצא הדם","כל חטאות המתות","וכל חטאת שתרעה","המפריש חטאתו ואבדה","ושחט שתיהן כאחת","ואף על פי","זו אחר זו","כל חטאת עוף","בה חוץ מעולת","חובה אין מועלין","מנחה שנתפגלה או","וכן קומץ שיצא","אבל אם נטמא","לא על הלן","באכילה אין מועלין","הנהנה מקדשי קדשים","שנהנה מן העולה","לנדבה מעל בקרבנות","נהנה קודם זריקה","קדשי המזבח חלבן","ולד המעשר לא","זו החולין יהיה","הקדיש בהמה ועוף","המפריש מעות לחטאתו","הקדיש אבר אחד","המפריש מעות לנזירותו","שלמים ואין בשלמים","דמי חטאת ילכו","אמר אלו לחטאתי","אמר אלו לעולתי","שלמים מעילה הפריש","בכולן ומועלין במקצתן","על החטאת ודמי","אחד ממחוייבי קינין","המפריש חטאת על","מעות לחטאת חלב","המפריש שתי סלעים","מעל וחייב לשלם","על מעילתו לפיכך","יביא השוה עשרה","אחד לאשם ואחד","אם היה זה","חמשה דינרים ויפלו","הנהנה מדמי חטאת","ויביא קרבן אשם","בדמיו אשמו ויביא","בדק הבית מעילתן","או שהפרישה ולא","שקרבה חטאתו יפלו","כך ובין כך","תפול מעילתו וחומשה","המוכר עולתו ושלמיו","אותו חכמים שיפלו","כולן יפלו לנדבה","יש מעילה בנדרים","לאחרים לפיכך אין","ואכלה בין הוא","הקדש נטלה על","האומר לחבירו ככרי","הנותן אינה אסורה","וכל דברים הנאסרין","האומר הנטיעות האלו","היום ולא נקצצו","אבל אם אמר","הקדש עד שיקצצו","אמורים בשפדאן המקדיש","לא נקצצו ויהיו","אחד המקדיש לבדק","דבר הראוי למזבח","אבן וקורה או","תרנגולין וחומץ וציר","בכולן משעה שהוקדשו","כל קדשי בדק","אכל והאכיל את","המעילה מצטרפת לזמן","אין מעילה אלא","פגם כיצד החורש","הקדש מעל שהאבק","להעלות אבק לעשב","אע\"פ שנהנה לא","בהן בית הדר","גידולי הקדש מועלין","בהן אבל המקדיש","שובך ונתמלא יונים","הקדש לא נהנין ולא מועלין ומה","מתוך שדה הקדש","חוץ לשדה מותר","הדיוט הסמוך לשדה","שש עשרה אמה הרי","יתר על שש עשרה הנהנה","השדה אם היה","שבתוך השדה הדיוט","קן שבראש האילן","המקדיש את היער","גזברים ששפו עצי","אבל אין מועלין","העץ הדומה ליבלת","המקדיש עבדו אין","הזורע פירות הקדש","שמרים של הקדש","המקדיש תרנגולת למזבח","כתנות כהונה שבלו","קדשי עכו\"ם אם","קול ומראה וריח","יש דברים שהאדם","כגון בגדים וכלי","מחובר בקרקע אם","שנפגם כגון שלבש","באותו דבר עצמו","ופגם בכחצי פרוטה","שפגם ולא פגם","בשוה פרוטה בדבר עצמו","בה בשוה פרוטה","זה לא מעל מפני","מצטרף ואפילו לזמן","קדשי קדשים התמימים","דומים לכוס של","מום הואיל ולמכירה","תלש מהן אחר","המועל בקדשי בדק","הואיל ואינו חייב","בו בשגגה מעל","ופגמו ולא הקנה","ואין מועל אחר","הקדש ונהנה בפרוטה","ונתנו לחבירו הוא","ושתה ונהנה ובא","הוא מעל וחבירו לא מעל רכב","ונהנה ופגם ובא","או מכרו או","טובת הנאה שבו","בהמת קדשי מזבח","ובא חבירו ותלש ובא","מעלו ויראה לי","בהמת קדשי הקדשים","אמרו חכמים שהנוטל","הגזבר שהיתה תחת","במועל בזדון שהרי","שיוציא אותה בחפציו","שאין מועל אחר","נטל אבן או","על גבי חלון","נטל פרוטה של","קנה בה חפץ","המוציא מעות הקדש","המביא חטאתו ואשמו","אין מועלין עד","שעבר עבירה לא","נתן שקלו ממעות","המפריש שקלו והוציאו","ידו הלך ושקלוע\"יעצמו","כמו שביארנו בשקלים","תרומה לא מעל","מי ששגג ולקח","שליחותו המשלח הוא","שמעל כיצד בעל","לו תן להן","לו הבא מן","מן החלון כמו","שהרי עשה שליחות","או קטן שאין","פטור אמר לשלוחו","שתים בעל הבית","הבית ולא עקר","האורחים שלש שלש","נמצא חבירו חייב","במה דברים אמורים","לא מעל אלא","אין שליח לדבר","הנותן פרוטת הקדש","לו בכולה נרות","והביא בחציה נרות","בפרוטה והשליח לא","ממקום פלוני ובחציה","ממקום נרות השליח","נתן לו שתי","השליח מעל ובעל","היה האתרוג שהביא","השולח פרוטה ביד","החנוני השליח מעל","כמו שביארנו נזכר","מעילה והחנוני חייב","לחנוני שפרוטה שנתנו","וכיצד יעשה כדי","של חולין או","פרוטה או הכלי","בכל הכיס או","חילל לא מעל","אמר כיס מכיסי","מביא את הגדול","מחולל על זה","המועל בפחות משוה","המפקיד מעות אצל","הפקידן אצל שולחני","לו רשות מן","לו השתמש בהן","האשה שהכניסה מעות","הפועלים שהן עושין","הדש כרשיני הקדש","אין מחללין את","אין נותנין לו","חולין נותנין אותן","כשבונין במקדש אין","קדש אלא בונין","מלאכה ואחר שישלם","לקודש לאותו היום","שנחוש להן שמא","כשפוסקין עם האומנין","באמה בת עשרים","עשרים וארבע אצבעות","תנאי בית דין","מלח שעל גבי","ראוי לאדם להתבונן","לו טעם ולא","מחשבתו בו כמחשבתו","ואבנים ועפר ואפר","בהן מנהג חול","ברוך הוא שלא","יחשוב בהן מחשבתו","ועשיתם אותם אמרו","שיעשה החוקים והשמירה","המצות שטעמן גלוי","וכיבוד אב ואם","לך רשות להרהר","בשר חזיר ובשר","מן המינים ומן","השקר שעורכין לפי","אני בכל לב","הקרבנות כולן מכלל","החוקים והמשפטים זוכין","שנאמר ושמרתם את"],"commentaries":[]}
