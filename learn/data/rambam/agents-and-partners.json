 הרי זו","במשא ומתן ושותפו","תקנו חכמים שכל","המתעסק חייב באחריותו","בעל המעות ואם","זו החצי אם","לאמצע בשוה שאם","עושה כלום אלא","לידי אבק רבית","שכרו שבכל יום","עסק אחר כל","אלא אפילו העלה","וכן אם אמר","זה מותר ואם","להעלות לו שכר אחר","ועוד תקנו חכמים","לו שכר עמלו","שליש ריוח הפקדון","הריוח חצי הריוח","הכל שני שלישי","הפחת שהרי הוא","של פקדון ונמצא","יש מי שטועה","יפסיד שליש ואין","מחצה ואם יהיה","שכר יטול המתעסק תשיעיתו","ריוח המתעסק יותר","זה מועיל אלא","יתר על הפסדו","הורו רבותי שאם","רביע המעות בלבד","יפסיד המתעסק שלשה","רביע שהוא שליש","בעל המעות מפסיד","בשכר אם יהיה","שלישו נמצאת למד","כלום שהרי רביע","המעות שהוא רביע","פחת המתעסק כפי","שליש מה שנטל","משלם רביע הפחת","תלך על דרך","אחד משבע' בשכר","שבעה דינרים הרי","לי שנים שהן","ואילו הפסיד ארבעה","שאין הדעת סובלת","לי שכל שירויח","התנו על ההפסד","נמצאת אתה אומר","שתות ואם התנו","הנותן מעות לחבירו","בשוה ונאבד הממון","ויראה לי שהוא","הגיע ההפסד ליטול","דינר ונשא ונתן","שמעון מאה וחמשה","נוטל חמשים ולעולם","שהיה אביהן מתעסק","טוענין ליורש הנה","לו כאן כנגד","כלל שנאמר אם","המתעסק רביע השכר","מן הממון מעט","או יתר ה\"ז","המתעסק שהפסיד וחזר","שהפסדנו תחלה ותפסיד","אלא מחשב באחרונה","נתן לו מאתים","על כל שטר","וחזר ונתן לו","אינו מחשב לו","במאה ושלשים והמאה","מאתים ולא הרויח","בבגדים עשרים ומפסיד","אין המתעסק יכול","לעצמי ואשא ואתן","בכולו ואם חלק","על אותן הדרכים","המתעסק שנתן מתנה","ברורה שאלו המלטלין","אותם ומכרם ונתנם","שהמתעסק שמת נשבע","של עסק הם","אלא א\"כ היה","הנותן מעות לחבירו","נתן לו מעות","ולא עצים וכן","באומנותו לפי שאין","מותר ולא יהיה","הנותן ביצים לבעל","אותן בעל התרנגולים","עגלים וסייחים על","שכר עמלו ומזונו בכל","עד שתהא טוענת","להיות מפטם אותה","שלך בעמלך יתר","אצלו וכן אם","בשלו ובשל חבירו","בשכר בשוה ואם","השם עגלים או","לו שכר הרי","ונוטל המתעסק שני","שמין פרה וחמור","הרי יש לו","ובעבודתה ואין שמין","השם בהמה לחבירו","והבקר ארבעה ועשרים","סתם לפי שאינו","בתחלה אלא בקושי","הרבה ומוספת בכל","הרי הולד מכלל","שנהגו שלא לגדל","רצה להטפל בהן","אחר כך יטול","בחצי של חבירו","מחל והולדות ביניהן","ויהיה כל השכר","שכר בהמה מעלין","המשתתף סתם לא","ראובן שהיתה לו","ולמכור הפירות וכל","שיטול ראובן יתר","מותר ואין כאן","הוא הנקרא אריס","אחר מנהג המדינה","בעל שהוריד אריסין","הם ואין להם","ירדו ושמין להם","האחין או שאר","כשותפין לכל דבר","אחד מהן ונתרפא","עד שחלה וכיוצא","השותפין כולן והאריסין","ונותנת בתוך הבית","בטענת ספק שמא","שבועה זו מפני","שנושאין ונותנין וטורחין","שיעשו כל מעשיהן","ואין כל אחד","מכאן הורו רבותי","שמא שהרי אינו","ויש מי שהורה","את האשה שנעשת","אע\"פ שאין שם","או בן ביתו","שבועה אלא לפוטרו","ומוציא פועלים ומכניס","אלא נכנס ברגלו","יתומים אין היתומים","בעלה ולא נשאה","בין מיתה וקבורה","על זה לא","המשלח ביד חבירו","שלא נתן לו","הרי זה כבן","מקצתה או המעות","השותפין שנושאין ונותנין","או המעות עם","מהן להשביע את","נתעסק עמו כלל","חלקו השותפין והאריסין","שקנה לו או","בטענת ספק אבל","לו שבועה אחר","הרי זה יכול","או בן ביתי","השותפים שחלקו ונשאר","חלקו והחוב שנשאר","ובן אם נשאר","זה את זה שהמעות","דבר קצוב וידוע","ועדיין לא חלקו","חשבון ולא ידע","מי שתבע את","לו להחרים סתם","שותף שטען על","שהקרן שלי היה","והלה אומר לא לקחתי","אלו הרשות ביד","וישבעו היסת על","מגלגל עליו כל","ימי השותפות ושהיה","התובע שותפו להשביעו","והתובע אומר עדיין","אותך שבועת השותפין","יכול להשביעו בטענת ספק אפילו","אלא חוב שזקפתו","להשביעו בטענת ספק ואינו","על ידי גלגול","יהיה חייב לשלם","ואפילוע\"יגלגול וכזה הורו","טען שעדיין שותפי","כלום או לא","שלא גזלתני כלום","טען שעדיין שותפין","והביא התובע עדים","כפרן לשבועה זו","ראובן שהטיל לכיס","ביחד והרי הממון","אומרים ישבע ראובן","ראובן שבועת השותפין שפחתו וילך","ששמעון יודע בודאי","הזה ואם לא","ההפסד ויפטר ולא","השותף מן הנשבעין","מדבר שהוא תחת","טען שמעון שיש","ללוי נאמן ונותנין","ראובן או מן","אפילו היתה המלוה","יודע בודאי שזה","או על ידי","חוב על לוי","לכיס או שאמר","על נכסי ראובן וכיצד","ראיה ישלם מביתו"],"commentaries":[]}
