צות בכור בהמה","לארץ שנאמר ואכלת","ממקום שאתה מביא","אי אתה מביא","ממנו ולא יקרב","כמו מעשר דגן","הכל חייבין בבכור","נולד לו בכור","כל הבכור אשר","פטורין כמו שביארנו","הבכור נאכל בתוך","וכי יהיה בו","ראוי להקרבה ואם","לאכילה ביום לידתו","נולד לו מום בתוך","לקיימו שלשים יום","בו מום בחמשה","שנתו אינו רשאי","הבכור בזמן הזה","ועד שלא נראה","אם נולד בו","שנה של בכור","לו ומונה לו","בראש חדש אדר שני זה","עלתה לו שנה וזה","ונולד בחדש העיבור","עבר ואיחר הבכור","מקריבו ואם היה","בקרך וצאנך מקיש","אין נותנין את","מעט ויתננו לכהן","חמשים יום ואם","לו שזה כמו","ובבית המטבחיים ובתוך","היה הבכור בעל","תנהו לי בתוך","כהן שאכל כזית","מעשר דגנך תירושך","זריקה בין לאחר זריקה לוקה","זריקה בין לאחר זריקה","הבכור אין פודין","מוכרין אותו כשהוא","הזה שאין בית","בין לכהן בין","בכור בעל מום יש","שחוט וכשהוא מוכר","איסורי מזבח אבל","מותרין לשקול מנה","המפשיט בכור בעל","כל המומים הקבועים","זה נשחט עליו","וכל הדברים שמנינו","עליהן כך אין","אם נולד בבכור","בו מום קבוע","וכן אם נעבדה","יוצא דופן והבא","בכור שהוא אנדרוגינוס","בו וגוזזים אותו","בין שהטיל מים","רחל שילדה כמין","הוא שור ובכורו","לך מום גדול","זה בכור לכהן","שיש בו מקצת","המטיל מום בבכור","בו מום אחר","הרגיל לבכור שיפול","או שהלך בין","בו מום הרי","נעשה שלא לדעתו","אמר אילו נפל","ראינוהו שעשה מעשה","למום זה או","מסורג בקוצים וכיון","היה בכור רודף","קטנים שהטילו מום","בכור שאחזו דם","מותר להטיל מום","עד שהעיד מפי","כל המומין הראויין","בכוונה וישחט עליהן","כהן והבכור עדיין","הטיל בו מום","כהן שהעיד לכהן","זה שכל הכהנים","עצמן אבל חבירו","לו על הבכור","בכור שהיה ביד","אם מום זה","מום זה למומחה","תם הוא שלא","וכן נאמן הכהן","לחוש לו שמא","תמים היה בעת","אין שוחטין את","בכורות במומן אפילו","הבכורות אדם רואה","אם אין שם","ידו או נשברה","בו מום מובהק","אין רואין את","לשחוט עליו וילך","בחוץ חשוד הוא","לו היה המום","בחזקת מדקדק על","השוחט את הבכור","שנחתכה ידו או","בכור שהיתה לו","ולא יצאת ביצה","מותר הואיל ומעכו","מי שאינו מומחה","רביע לדקה ומחצה","ישהנה ולא יגדל","הנוטל שכרו להיות","בו חכמים שאין","תמים ולא יטול","כדי שלא יבוא","החשוד על הבכורות","דומה לבשר עגל","זכרותו ויאמר עור","צואי אבל לוקחין","שהוא מפחד לשהותו","השוחט את הבכור","ומה שלא נאכל","בכור שנמצא טרפה","פסולי המוקדשין והבשר","הבכור שנאכל בשרו","בגיזותיו אבל כל","נשר ממנו אחר","הצמר שנשר ממנו","שלא גזרו גזירה","אצלו כדי ליקח","בכור שהיה בו","גיזת בכור אפילו","הרי הוא דבר","בהמת השותפין חייבת","שותף בפרה או","היה לו באחד","זה פטור ואם","הלוקח עובר פרתו","המקבל בהמה מן","המקבל צאן מן","אע\"פשברשות ישראל הם","ממנו יגבה מן","והרי יד הנכרי","שהרי של ישראל","ישראל שנתן מעות","בבכורה וכן אם","גר שנתגייר ואין","הלוקח בהמה מן","לקח בהמה מניקה","שילדה ואפילו היה","וכן בהמה שהיא","הלוקח בהמה מישראל","בהמה דקה שהפילה","אם אמרו הרועים","לרועה חכם לפיכך","זה ספק בכור","ולד שאין שליא","מתקדש בבכורה אלא","שאין בו מקצת","בבכורה ואין חוששין","בהמה גסה שהפילה","הדם והפסידו ובטלו","קוברין אותה כדי","כבר ביארנו בענין","ולד אבל ולד","אינה מתעברת אחריו","בהמה שיצאה מליאה","מבכרת המקשה לילד","ונפטרה מן הבכורה ואם","צריכין קבורה ונפטרה","יצא שליש ומכרו","דרך דופן ושני","יצא מיעוט אבר","חצי העובר והוא","הבא אחריו ספק","בכור שכרכו בסיב","הדביק שני רחמים","נפתחו כותלי בית","נעקרו כותלי בית","נגממו כותלי בית","רחל שלא בכרה","הואיל ואין ידוע","מהן אין לכהן","ונקבה הרי הזכר","שתי רחלות שלא","ונקבה הכהן נוטל","החי ספק בכור","ושתי נקבות הרי","אין כאן לכהן כלום שהמוציא","שני זכרים אחד","אין כאן לכהן כלום שזה החי","כל בכור שהוא","אותו מידו ואוכל","שמא ישחוט חולין","מי שהיה בעדרו","מניקות נקבות ואת","זו ובנה של","שנים שהפקידו שני","השני ביניהן ומסתלק","הפקיד בכור אצל","המוציא מחבירו עליו הראיה והרי","בעל הבית עם פשוט של","מחצר בעל הבית","לא נחשדו ישראל","כל הקדשים שקדם","או שהקדישן תמימים","יצאו לחולין לכל","הלוקח בהמה ממעות","הרי זו פטורה","בה לאכלה לאכלה","מתורת פירות שביעית","האסורים באכילה וכן","סחורה בבכורות אף","לקח בכור למשתה","אין שמין בכורות","תמימים לכהנים בזמן","מצות עשה להפריש","מעשר בהמה נוהג","בפני הבית אבל","גזירה שמא יאכלהו","ועשה בזמן הזה","הכל חייבין במעשר","ודין מעשר בהמה","אימוריו ושאר הבשר","אלא כולו לבעלים","מעשר בהמה אסור","לא יגאל אף","לא עשה כלום","יפת תואר כמו","מדברי סופרים שאסור","ומעשר בהמה של","מעשר בהמה שנשחט","אלא בשרו בלבד","ואם היו דמי","הכל נאמנים על","נאמנים על הבכור","שאם ירצה יטיל","הלוקח טלאים שנולדו","ברשותו לפיכך השותפין","ונשתתפו בהן הרי","מאביהם הרי הן","בין לשותפין בין","השותפות והאחים שקנו","במעשר שהרי ברשותן","הבהמות ברשותן וחזרו","לקוחין והלקוח פטור","ברשותן אחר שיתוף","כנגד עשרה הכל","האחין והשותפין שחלקו","הלוקח עשרה עוברים","כהן שנפלו לו","הכל נכנסין לדיר","והטריפה ויוצא דופן","נשחטה עם לידתו","אין הלוקח פטור","ימי הלידה כשיגיע","שלקח עוברים ונולדו","כל בהמה שהיא","שנתערב בהן יתום","מי שהיו לו","מעשר אלא כיצד","יצאו שנים כאחד","הדיר לקראתן שנאמר","מן הדיר זה","נקבה בין תמים","בשבט או שמנאן","אין צריך לצרף","חמשה טלאים בירושלים","יהיה בין אלו","היו שלשה עדרים","אין מעשרין מן","ומן העזים על","אין מעשרים מן","מן החדש על","בהמה משנה על","בפירוש שיהיה שנה","כל הנולדים באחד","חמשה טלאים בעשרים","שנתן הרי היא","אין הטלאים הנולדים","אלא מותר למכור","קבעו חכמים שלשה","עד שיעשר ואם","חמשה עשר קודם עצרת","נמצאת אומר שהגרנות","העומר וביום אחרון","מצויות לעולי רגלים","למכור עד שיעשרו","הכניס כל הצאן","מעשרה הרי זה","ואף על פי","המכניס צאן לדיר","לשמיני או לשלמטה","אבל אם קרא","מתקדשות למעשר שלמעלה","לתשיעי עשירי ולעשירי","והיאך דינם התשיעי","וטעון נסכים כשלמים","כשהיה המונה הוא","עשר אין מקדש","זה שאמרנו שאם","עשירי וקרא אחריו","עשירי מעליו ואפילו","אחד עשר וקראהו","ולא עקר שם","יצאו תשיעי ועשירי","ויאכלו במומן ואינן","ואחד עשר מעורבים","בהלכות פסולי המוקדשין","התחיל למנות ויצאו","יצאו בתחילה שנים","הרי התשיעי והעשירי","שנים יצאו בתחילה","מנאן למפרע כגון","קרא לתשיעי עשירי","אף על פי","וכל השמונה שיצאו","שיצא שהמניין הראוי","הכניס עשרה טלאים","מת אחד מאלו","שלא הפריש עליהן","וכן מי שהיו","ששה ומנאן בפתח","שיצאו בו הששה","מניין הראוי פטרן","הרי אותם הארבעה","אחד מהן נמנה","אבל אלו הארבעה","מצטרפין לגורן אחר יצאו","הששה מאחד משני","הרי הששה מצטרפין","מהן נמנו מניין","היו לו תשעה","היה מונה והוציא","היה מונה והפסיק","היה מונה היוצאין","שעדיין לא נמנו","וכבר ביארנו שכל","קפץ אחד מן"],"commentaries":[]