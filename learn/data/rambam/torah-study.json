,"בני חכמים בזמן","הופכין פניהן כלפי העם","תלמיד שהוא יושב","מי שהוא זקן","עומד בפני הזקן","זקן כותי מהדרין","תלמידי חכמים אינם","בהן כדי שלא","השומרים וכיוצא בהן","קצוב על בני","ויחלו מעט ממשא","ואין מניחים אחד","בעלי דינים הרבה","עון גדול הוא","שנאמר ויהיו מלעיבים","בוזים מלמדי דבריו","המבזה את החכמים","אע\"פ שהמבזה את","ומנדין אותו בית","את החכם בדברים","בתשובה אבל אם","עצמו מנדה לכבודו","לו עד שירצה","הרב שנידה לכבודו","עצמו אין הרב","לנשיא מנודה לכל","לעיר אחרת מנורה","בד\"א במי שנדוהו","נידוי אפילו נידהו","בתשובה מדבר שנידוהו","בין איש בין","הקורא לחבירו עבד","סופרים ואין צריך","מי שיש ברשותו","המוכר קרקע שלו","כוכבים לישראל חבירו","ממנו בעדותו ממון","ונותנן לכהן אחר","מנהג העושה מלאכה","הבאי המביא את","המחשב שנים וקובע","מצוה טבח שיצאה","מי שגירש את","כשיבואו לבית דין","חכם זקן בחכמה","כירבעם בן נבט","וכשל גם נביא","חכם שנתחייב נידוי","ממנו וחסידי החכמים","להלקותו אם נתחייב","וכיצד הוא הנידוי","וכיצד מתירין הנידוי","מהו המנהג שינהוג","ימי נידויו ואין","עמו בארבע אמות","דין שולחין ומניחין","ואין צריך לומר","יותר עליו המוחרם","תלמודו ואינו נשכר","אלא מעט עסק","מי שישב בנידוי","בכמה מתירין הנידוי","","שלשה שנידו והלכו","מי שלא ידע","נידוי על תנאי","מי שנידוהו בחלום","מנידויו ואם לא","לא מצא מתירין לו עשרה","יודעין לקרות לא","מי שנידוהו בפניו","ושלא בפניו ואין","למוטב ואם ראו","דין להחרים לזה","אמות מחרימין כדי","שיש רשות לחכם","אזניו מדברי עם","ידברו אל תתן","עוד אלא שמוחלים","ואומרים שמעולם לא","שראוי לילך בה","חרפו אדם בפרהסיא","ונוטר הדבר כנחש"],"commentaries":[]}
