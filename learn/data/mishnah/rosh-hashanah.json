טיעה נקלטת בשתי","ושלשים יום אחר","דשלשים יום בשנה","הרי מ״ה יום","ולתשרי של שנה","ולאחר שנה שלישית","אם חנטו בנטיעה","עדיין הם אסורים","שאע״פ שתשרי ר״ה","ט״ו בשבט ר״ה","לפיכך אין שנתו","ומשם ואילך אם","ובט״ו בשבט לשנה","ולירקות למעשר ירק","תורמין מן הירק","ראש השנה לאילן","על שחנטו לאחר","אי נמי נפקא","שאותן פירות שחנטו","ומשבט ואילך נוהג","בארבעה פרקים בשנה","בפסח על התבואה","מינה ידעינן דבפסח","ובעצרת על פירות","מדאמרה תורה הביאו","וחטה עץ קרייה","כמאן דאמר עץ","כבני מרון כבני","ככבשים הללו שמוציאין","ואין שנים יכולים","היוצר יחד לבם","היוצר והוא הקב״ה","מ״מ כולן נסקרים","ובחג נידונין על","מדאמרה תורה נסכו","שלוחין יוצאין כשקדשו","אם ביום שלשים","אם ביום ל״א","ושלוחי בית דין","ועל אב מפני","לפי שהוכפלו בו","ועל אלול מפני","מודיעין מתי אלול","דרוב שנים אין","ואע״פ שספק בידם","אי אפשר להם","ואם לא ידעו","ועל תשרי מפני","לאחר שקדשו בית","השלוחין יוצאין ליום","כדי שלא יהא","פסח קטן פסח","מחללין את השבת","כדי לילך ולהודיע","שבהם שלוחי בית","להודיע לגולה יום","הלכך חשיבי ומן","אבל רבנן אסרו","אבל שני חדשים","שכל המועדות תלויין","תקנת קרבן של","בעליל למעלה מן","שלא בעליל למטה","ואדמומית החמה מכסה","אין מחללין דודאי","ואין הלכה כרבי","ארבעים זוג כתי","ועכבן רבי עקיבא","אתה מכשילן לעתיד","שימנעו מלבוא להעיד","והלכה כרבן גמליאל","אב ובנו וכל","דאמר להו רחמנא","עדות זו של","ורבנן דפליגי עליה","החדש הזה לכם עדות זו תהא","לגדולים שבדור כמותכם","ואין הלכה כרבי","משחקים בקוביא עצמות","ואמור רבנן אסמכתא","ומלוי בריבית לא","דהא מנפשיה יהיב","מפריחי יונים היינו","אם תקדמיה יונך","וסוחרי שביעית עושין","ורחמנא אמר לאכלה","ולפי שנחשדו כל","חשדום להיות מעידים","והעבדים פסולים דאורייתא","עדות שאין האשה","לפי שיש עדות","כגון להעיד לאשה","וכן להעיד על","והנך פסולין דרבנן","נמי כשרים אבל","ואע״פ שהכשירו העבד","ואם צודה להם","שנאמר אלה מועדי","אם אינן מכירין","אם אין בית","משלחים בית דין","אחר עמו זוג","להעיד עליו לפני","משקלקלו המינין ששכרו","היו משיאין משואות","לאחר שקידשו החודש","ולא היו צריכין","שהמשואות היו מודיעין","משקלקלו הכותים והשיאו","להטעות לפי שבית","וכשלא היו משיאין","ופעם אח